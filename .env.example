# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000/api/v1
BACKEND_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=/api/v1
MONGODB_URI=mongodb://127.0.0.1:27017/skillbarter_next
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Use a separate random secret (at least 32 characters); never reuse a JWT secret.
ADMIN_BOOTSTRAP_SECRET=replace-with-a-separate-random-admin-bootstrap-secret

# Resend email delivery (optional in development, required in production)
RESEND_API_KEY=
EMAIL_FROM=SkillBarter <noreply@your-verified-domain.example>

# 2Factor SMS OTP delivery (India +91 only; required in production)
TWOFACTOR_API_KEY=
